int pirPin = 12;                           // PIR OUT pin connected to GPIO12
int buzzerPin = 32;                        // Buzzer +ve pin connected to GPIO32
int motionState = LOW;

void setup() {
  pinMode (pirPin, INPUT);
  pinMode (buzzerPin, OUTPUT);
  Serial.begin(115200);                    //Setting the baud rate at 115200
  Serial.println("Starting!!");
}

void loop() {
  int motionState = digitalRead(pirPin);   //Reading signal from PIR

  if (motionState == HIGH) {               // Checking motion detection
    Serial.println("Motion Detected! Ringing buzzer...");

    digitalWrite(buzzerPin, HIGH);

    digitalWrite(buzzerPin, HIGH);         //Keeps the BUZZER ON
  }

  else {
    Serial.println("No Motion Detected!");
    
    digitalWrite(buzzerPin, LOW);          //Ensuring Buzzer is OFF
  }
}
